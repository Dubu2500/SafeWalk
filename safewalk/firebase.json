{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "safewalk-fb1e9",
          "appId": "1:1019858631171:android:bb10881c7983505877ec36",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "safewalk-fb1e9",
          "configurations": {
            "android": "1:1019858631171:android:bb10881c7983505877ec36",
            "ios": "1:1019858631171:ios:a334771cd995d85b77ec36"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "tracking",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/track",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  }
}
